# Config var hanya untuk rahasia, identitas, dan hal yang berbeda antara laptop
# dan Heroku. Setelan lain dipatok di app/config.py.
# Salin ke .env untuk pengembangan lokal.

# --- Rahasia ----------------------------------------------------------------
TELEGRAM_BOT_TOKEN=123456:ganti-dengan-token-dari-BotFather
NOTION_TOKEN=secret_...
TELEGRAM_WEBHOOK_SECRET=           # string acak; dicocokkan pada tiap update masuk
MINIAPP_DEV_TOKEN=                 # isi hanya untuk uji lokal tanpa Telegram

# --- Identitas --------------------------------------------------------------
TELEGRAM_OWNER_ID=                 # user id kamu; bot menolak siapa pun selain ini
TELEGRAM_PROMPT_CHAT_ID=           # tujuan laporan otomatis bot; kosong = japri owner
TELEGRAM_PROMPT_THREAD_ID=         # topik forum di grup itu (angka kedua di link t.me/c/<id>/<topik>)

# --- Beda antara laptop dan Heroku ------------------------------------------
BASE_URL=https://nama-app.herokuapp.com   # kosongkan saat uji lokal
REDIS_URL=                         # diisi otomatis oleh add-on Heroku Key-Value Store
USE_POLLING=false                  # true untuk uji lokal: ambil update tanpa URL https publik
