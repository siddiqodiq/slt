# Config var hanya untuk rahasia, identitas, dan hal yang berbeda antara laptop
# dan Heroku. Setelan lain dipatok di app/config.py.
# Salin ke .env untuk pengembangan lokal.
#
# Komentar selalu di baris sendiri, jangan di belakang nilai: untuk var yang
# kosong, python-dotenv memungut teks setelah '#' sebagai nilainya.

# --- Rahasia ----------------------------------------------------------------
TELEGRAM_BOT_TOKEN=123456:ganti-dengan-token-dari-BotFather
NOTION_TOKEN=secret_...

# String acak; dicocokkan pada tiap update masuk.
TELEGRAM_WEBHOOK_SECRET=

# Isi hanya untuk uji lokal tanpa Telegram. JANGAN diisi di Heroku:
# selama tidak kosong, dashboard bisa dibuka tanpa autentikasi Telegram.
MINIAPP_DEV_TOKEN=

# --- Identitas --------------------------------------------------------------
# User id kamu; bot menolak siapa pun selain ini.
TELEGRAM_OWNER_ID=

# Tujuan laporan otomatis bot; kosong = japri owner.
# Dari link t.me/c/<id>/<topik>, chat id = -100 diikuti <id>.
TELEGRAM_PROMPT_CHAT_ID=

# Topik forum di grup itu (angka kedua di link t.me/c/<id>/<topik>).
TELEGRAM_PROMPT_THREAD_ID=

# --- Beda antara laptop dan Heroku ------------------------------------------
# Kosongkan saat uji lokal.
BASE_URL=https://nama-app.herokuapp.com

# Diisi otomatis oleh add-on Heroku Key-Value Store; biarkan kosong.
REDIS_URL=

# true untuk uji lokal: ambil update tanpa URL https publik.
USE_POLLING=false
